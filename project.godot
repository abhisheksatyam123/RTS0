; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="RTS0"
run/main_scene="res://scenes/menu/main_menu.tscn"
; Android Back closes dialogs and opens menus (scenes/common/touch_input.gd), never quits.
config/quit_on_go_back=false
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.png"

[autoload]

MatchSettings="*res://scenes/menu/match_settings.gd"
UserSettings="*res://scenes/menu/user_settings.gd"
LobbySession="*res://scenes/menu/lobby_session.gd"
Tooltips="*res://scenes/common/tooltips.gd"
MenuAudio="*res://scenes/common/menu_audio.gd"
TouchInput="*res://scenes/common/touch_input.gd"
SafeArea="*res://scenes/common/safe_area.gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/rts0_export/plugin.cfg")

[gui]

; Godot 4.3 PopupPanel tooltips disconnect the root Window with an empty
; Callable (focus_entered / tree_exited). Keep native tooltips off.
timers/tooltip_delay_sec=3600.0

[rendering]

; Phones and tablets run GL Compatibility: the cheapest on mobile GPUs and every
; device has it (docs/BUILD.md "Mobile renderer").
renderer/rendering_method.mobile="gl_compatibility"

textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.12, 0.14, 0.18, 1)
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=1
textures/default_filters/anisotropic_filtering_level=4

[threading]

worker_pool/max_threads=-1

[importer_defaults]

scene={
"meshes/generate_lods": false,
"meshes/light_baking": 0
}

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[shader_globals]

rtso_pp_hdr={
"type": "float",
"value": 0.0
}
rtso_pp_brightness={
"type": "float",
"value": 0.0
}
rtso_pp_contrast={
"type": "float",
"value": 1.0
}
rtso_pp_saturation={
"type": "float",
"value": 1.0
}
rtso_pp_bloom={
"type": "float",
"value": 0.2
}
rtso_water_effects={
"type": "float",
"value": 1.0
}
rtso_water_fancy={
"type": "float",
"value": 1.0
}
rtso_water_reflection={
"type": "float",
"value": 1.0
}
rtso_water_refraction={
"type": "float",
"value": 1.0
}
rtso_water_realdepth={
"type": "float",
"value": 1.0
}
