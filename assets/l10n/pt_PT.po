msgstr "%(amount)s %(name)s"

msgid "%(amount)s %(resourceType)s"
msgstr "%(amount)s %(resourceType)s"

msgid "%(amount)s / %(max)s"
msgstr "%(amount)s / %(max)s"

msgid "%(amount)s%%"
msgstr "%(amount)s%%"

