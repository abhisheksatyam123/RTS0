msgid "  hotkey.session.rotate.cw – Rotate structure 15 degrees clockwise"
msgstr "hotkey.session.rotate.cw – obróć budynek o 15 stopni zgodnie z ruchem wskazówek zegara"

msgid "  hotkey.session.savedgames.delete – Delete the selected saved game, ask for confirmation"
