msgid "  hotkey.timeelapsedcounter.toggle – Toggle time elapsed counter"
msgstr "  hotkey.timeelapsedcounter.toggle – włącza licznik czasu"

msgid "  hotkey.togglefullscreen – Toggle between fullscreen and windowed"
msgstr "  hotkey.togglefullscreen – przełącza między trybem pełnoekranowym a okienkowym"

