msgstr "戰神廟"

msgid "TempleOfVesta"
msgstr "灶神廟"

msgid "Temples and Wonder −50% stone cost and build time."
msgstr "神廟和奇觀 -50% 石成本和建造時間。"

msgid "Temples −50% resource costs and build time. Temple technologies −50% resource costs and research time."
msgstr "神廟 -50% 資源成本與建造時間。神廟科技 -50% 資源成本與研發時間。"

msgid "Temples −50% resource costs and building time; Temple technologies −50% resource costs and research time."
msgstr "神廟 -50% 資源成本與建造時間；神廟科技 -50% 資源成本與研發時間。"

msgid "Tent"
msgstr "營帳"

msgid "Terms"
msgstr "條款"

