msgid "Aligning structures allows to conserve space for future construction."
msgstr "건축물들을 정렬하면 향후 건설을 위한 공간을 절약할 수 있습니다."

msgid "All Citizen-Soldiers −20% required promotion experience."
msgstr "모든 주민 병사들의 필요한 진급 경험치가 −20% 감소합니다."

msgid "All Hotkeys"
msgstr "모든 단축키"

msgid "All Infantry Units +5% movement speed, and gain +1 loot taking."
msgstr "모든 보병 유닛의 이동 속도가 +5% 증가하고, 전리품 획득량이 +1 증가합니다."

msgid "All Land Units +5% movement speed."
msgstr "모든 지상 유닛의 이동 속도가 +5% 증가합니다."

msgid "All Maps"
msgstr "모든 지도"

msgid "All Roads Lead To Rome. Via Julia Augusta a Roman road built in 13 BC."
msgstr "모든 길은 로마로 통한다. 비아 줄리아 아우구스타(Via Julia Augusta)는 기원전 13년에 건설된 로마의 도로입니다."

msgid "All Warships +40% capture resistance."
msgstr "모든 군선의 포획 저항력이 +40% 증가합니다."

msgid "All available hotkeys."
msgstr "사용 가능한 모든 단축키"

msgid "All displayed"
msgstr "모두 표시됨"

msgid "All maps except naval and demo maps."
msgstr "해상 및 데모 지도를 제외한 모든 지도입니다."

msgid "All personal data that Wildfire Games processes is obtained from the user (GDPR 14)."
msgstr "Wildfire Games가 처리하는 모든 개인 데이터는 사용자에서 가져옵니다(GDPR 14)."

msgid "All players start on one bank of the river, with minimal harvestable metal. Across the Gambia River is a savanna with many deposits of metal to be claimed. \n\n(Warning: Large map. Good computer specs recommended)"
msgstr "모든 플레이어들은 수확할 수 있는 최소한의 금속으로 강의 한 둑에서 출발합니다. 감비아 강 건너편에는 많은 금속이 매장되어 있는 사바나가 있습니다.\n\n(경고: 큰 지도입니다. 좋은 컴퓨터 사양이 권장됩니다.)"

msgid "All players starts on a continent surrounded by water."
msgstr "모든 플레이어들은 물로 둘러싸인 대륙에서 시작합니다."

msgid "All roads lead to Rome."
msgstr "모든 길은 로마로 통한다."

msgid "All structures +20% health."
msgstr "모든 건축물들의 내구력이 +20% 중가합니다."

msgid "All structures −10% build time and −10% cost."
msgstr "모든 건축물들의 건설 시간과 비용이 -10% 감소합니다."

msgid "All technologies have −20% resource cost and −30% research time."
msgstr "모든 기술의 자원 비용이 -20%, 연구 시간이 -30% 감소합니다."

msgid "All your units are now gathering resources. We should train more units!\n"
msgstr "모든 유닛이 자원을 채집하고 있습니다. 우리는 더 많은 유닛을 훈련시켜야 합니다!\n"

msgid "Allied Cavalry"
msgstr "동맹 기병"

msgid "Allied Heroes +10% health."
msgstr "동맹 영웅의 체력을 +10% 증가합니다."

msgid "Allied Victory"
msgstr "동맹 승리"

msgid "Allied View"
msgstr "동맹 보기"

msgid "Allied with Rome, Philip reorganized the country's internal affairs and finances, leaving as a legacy reopened mines and a new currency.\nGain a slow trickle of metal."
msgstr "로마와 동맹을 맺은 필리포스는 국가의 내정과 재정을 재편성하여, 유산으로는 다시 문을 연 광산과 새로운 화폐를 남겼습니다.\n천천히 금속을 얻습니다."

msgid "Allies"
msgstr "동맹국"

msgid "Allies +20% international trade bonus."
msgstr "동맹국의 국제 교역 보너스가 +20% 증가합니다."

msgid "Allies are allowed to use this dropsite."
msgstr "동맹은 이 회수 시설을 사용할 수 있습니다."

msgid "Allow everybody or buddies only to join the game as observer after it started."
msgstr "모든 사람 또는 친구들이 게임을 시작한 후에는 관찰자로 게임에 참여할 수 있습니다."

msgid "Allow units access through Palisades. Can be locked to prevent access."
msgstr "말뚝 울타리를 통해 유닛들이 접근하는것을 허용합니다. 접근을 방지하기 위해 잠글 수 있습니다."

msgid "Allow units access through Walls. Can be locked to prevent access."
msgstr "성벽을 통해 사람들이 접근할 수 있게 합니다. 접근을 막기 위해 잠글 수도 있습니다."

msgid "Allow water to reflect a mirror image."
msgstr "물이 반사 이미지를 반영하도록 합니다."

msgid "Allows bribing the units of other players in order to share their vision."
msgstr "시야를 공유받기 위해 다른 플레이어들의 유닛에게 뇌물을 줄 수 있습니다."

msgid "Allows using allied dropsites."
msgstr "동맹의 회수 시설을 사용할 수 있습니다."

msgid "Ally"
msgstr "동맹"

msgid "Ally chat"
msgstr "동맹 대화"

msgid "Along with his brother Indibil, Mandonius commanded the Iberian recruits and mercenaries that took part in the Punic Wars.\nAllied Citizen Mercenaries −25% metal cost."
msgstr "만돈니우스는 형제인 인디빌과 함께 포에니 전쟁에 참가한 이베리아족 신병과 용병들을 지휘했습니다.\n동맹의 주민 용병 금속 비용이 -25% 감소합니다."

msgid "Alpha XXVII: Agni"
msgstr "알파 XXVII: 아그니 (불의 신)"

