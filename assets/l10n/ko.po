msgid "Pirate"
msgstr "해적"

msgid "Pirate Port"
msgstr "해적항"

msgid "Pitch can be made from petroleum, coal tar, or pine tar. It can be used to help seal the hulls of boats as well as assist in igniting enemy ships."
msgstr "피치는 석유, 콜타르, 소나무 타르로 만들 수 있습니다. 피치는 배의 선체를 밀봉하고 적 함선에 불을 붙이는 데에도 사용되었습니다."

msgid "Pixelated"
msgstr "픽셀화됨"

msgid "Placement Obstructor"
msgstr "배치 방해물"

msgid "Placement obstructor to prevent construction but not movement"
msgstr "건설을 방해하지만 움직이지 않는 배치 장애물"

msgid "Placement obstructor to prevent movement and construction."
msgstr "이동 및 건설을 방지하기 위한 배치 장애물입니다."

msgid "Play around with the Gallic faction in an idyllic sandbox setting."
msgstr "목가적인 샌드박스 설정에서 갈리아 파벌과 함께 즐기십시오."

msgid "Play with the Athenians faction in a non-threatening sandbox environment."
msgstr "위협적이지 않은 샌드박스 환경에서 아테네인 파벌과 함께 게임 진행합니다."

msgid "Play with the Macedonians faction in a non-threatening sandbox environment."
msgstr "위협적이지 않은 샌드박스 환경에서 마케도니아족의 파벌과 함께 플레이합니다."

msgid "Play with the Ptolemaic Egyptians in a non-threatening sandbox setting."
msgstr "위협적이지 않은 샌드박스 환경에서 프톨레마이오스 왕조의 이집트인들과 함께 게임 진행합니다."

msgid "Playback previous games."
msgstr "이전 게임을 재생합니다."

