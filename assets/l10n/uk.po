msgstr "Активувати автоматичну чергу для вибраних споруд."

msgid "Add a worker to finish the construction in %(second)s second."
msgstr "Додайте працівника, щоб закінчити побудову за %(second)s секунду."

msgid "Add a worker to finish the construction in %(second)s seconds."
msgstr "Додайте працівника, щоб закінчити побудову за %(second)s секунди."

msgid "Add a worker to finish the repairs in %(second)s second."
msgstr "Додайте ще працівника для закінчення ремонту через %(second)s секунду."

msgid "Add a worker to finish the repairs in %(second)s seconds."
msgstr "Додайте ще працівника для закінчення ремонту через %(second)s секунди."

msgid "Add another worker to speed up the construction by %(second)s second."
msgstr "Додайте іншого працівника, щоб прискорити будівництво на секунду."

msgid "Add another worker to speed up the construction by %(second)s seconds."
msgstr "Додайте іншого працівника, щоб прискорити будівництво на секунди."

msgid "Add another worker to speed up the repairs by %(second)s second."
msgstr "Додайте ще працівника для пришвидшення ремонту на %(second)s секунду."

msgid "Add another worker to speed up the repairs by %(second)s seconds."
msgstr "Додайте ще працівника для пришвидшення ремонту на %(second)s секунди."

msgid "Add only military units to the selection."
msgstr "Додати тільки воєнних юнітів до вибору."

msgid "Add only non-military units to the selection."
msgstr "Додати тільки невоєнних юнітів до вибору."

msgid "Add to selection"
msgstr "Додати до вибору"

msgid "Add units to selection."
msgstr "Додати юнітів до вибору."

msgid "Additional music"
msgstr "Додаткова музика"

msgid "Additional music, percussion, djembe, sampling"
msgstr "Додаткова музика, ударні, джембе, семпли"

msgid "Adjust game settings."
msgstr "Відрегулювати налаштування гри."

msgid "Adjust hotkeys."
msgstr "Відрегулювати гарячі клавіші."

msgid "Adjust the game window to your preferences.\n"
msgstr "Відрегулювати вікно гри відповідно до Ваших уподобань.\n"

msgid "Administrator"
msgstr "Завідатель"

msgid "Adminius"
msgstr "Адміній"

msgid "Adretos"
msgstr "Адретос"

msgid "Advanced"
msgstr "Додатково"

msgid "Advanced Handicraft"
msgstr "Просунуте ремісництво"

msgid "Advanced Siege"
msgstr "Просунута облога"

msgid "Advanced technologies improve siege efficiency."
msgstr "Просунуті технології вдосконалюють ефективність облоги."

msgid "Advances from a bustling town to a veritable metropolis, full of the wonders of modern technology."
msgstr "Просуває з метушливого містечка до справжньої метрополії, наповненої дивами новітньої технології."

msgid "Advances from a bustling town to a veritable metropolis, full of the wonders of modern technology. This is the Athenian city phase, where metal gathering rates are boosted because of the 'Silver Owls' bonus."
