msgstr "%(_player_)s birtokol egy csodát, így szövetségeseivel egyetemben %(_player_)s bizonyos időn belül (%(time)s) nyerni fog."

msgid "%(_player_)s owns a Wonder and will win in %(time)s."
msgstr "%(_player_)s birtokol egy csodát, így bizonyos időn belül (%(time)s) nyerni fog."

