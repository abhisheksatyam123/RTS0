msgstr "Εργάτες +20%  ρυθμός συλλογής σπόρων"

msgid "Workers +25% metal gather rate."
msgstr "Εργάτες +25% στο ρυθμό συγκομιδής μετάλλου."

msgid "Workers +25% stone gather rate."
msgstr "Εργάτες +25% στο ρυθμό συγκομιδής πέτρας."

msgid "Workers +25% wood gather rate."
msgstr "Εργάτες +25% στο ρυθμό συγκομιδής ξύλου."

