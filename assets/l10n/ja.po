msgid "    • With hotkey.session.noconfirmation – Immediately delete currently selected unit(s)/structure(s), without asking for confirmation"
msgstr "    • With hotkey.session.noconfirmation – 確認を求めることなく、現在選択されているユニット/建築物を即座に削除します"

msgid "    • With hotkey.session.savedgames.noconfirmation – Don't ask for confirmation"
msgstr "    • With hotkey.session.savedgames.noconfirmation – 確認を求めない"

msgid "  Alt + Double Left Click \\[on unit] – Select all your units of the same kind on the entire map (even if they have different ranks)"
msgstr " 　Alt + Double Left Click \\[on unit] – マップ全体で同じ種類のユニットをすべて選択します（ランクを問わず選択されます）"

msgid "  Alt + Triple Left Click \\[on unit] – Select all your units of the same kind and rank on the entire map"
msgstr "　Alt + Triple Left Click \\[on unit]  – マップ全体で同じ種類、同じランクのユニットをすべて選択する"

msgid "  Double Left Click \\[on unit] – Select all of your units of the same kind on the screen (even if they're different ranks)"
msgstr "　Double Left Click \\[on unit] – 同じ種類のユニットをすべて選択します。（ランクが違っても画面に表示されます。）"

msgid "  Triple Left Click \\[on unit] – Select all of your units of the same kind and the same rank on the screen"
msgstr "　Triple Left Click \\[on unit] – 画面上の同じ種類、同じランクのユニットをすべて選択することができます。"

msgid "  highlightguarding.showstatusbars – See all status bars (which would also show the building progress)"
msgstr "  highlightguarding.showstatusbars – すべてのステータスバーを表示（建設中の進捗状況も表示されます）"

msgid "  hotkey.bigscreenshot – Take huge screenshot (6400×4800 pixels, in .bmp format, location is displayed in the top left of the GUI after the file has been saved, and can also be seen in the console/logs if you miss it there)"
msgstr "  hotkey.bigscreenshot – より大きなスクリーンショットを撮ります。（6400×4800ピクセル、.bmp形式、場所はファイル保存後にGUIの左上に表示され、コンソール/ログでも確認できます）"

msgid "  hotkey.camera.down – Pan screen down"
msgstr "  hotkey.camera.down – パン スクリーンダウン"

msgid "  hotkey.camera.jump.1 – Move the camera to a marked position. Jump back to the last location if the camera is already over the marked position"
msgstr "  hotkey.camera.jump.1 – カメラを登録した位置に移動します。カメラがすでに登録された位置の上にある場合、最後の位置にジャンプして戻ります。"

msgid "  hotkey.camera.jump.set.1 – Mark the current camera position, for jumping back to later (by default, there are 4 possible positions)"
msgstr "  hotkey.camera.jump.set.1 – 現在のカメラ位置を登録し、後でジャンプして戻ることができます（デフォルトでは、4つの位置が登録可能です）"

msgid "  hotkey.camera.left – Pan screen left"
msgstr "  hotkey.camera.left – パン スクリーンレフト"

msgid "  hotkey.camera.right – Pan screen right"
msgstr "  hotkey.camera.right – パン スクリーンライト"

msgid "  hotkey.camera.rotate.down – Rotate camera to look downward"
msgstr "  hotkey.camera.rotate.down – カメラを下向きに回転させる"

msgid "  hotkey.camera.rotate.up – Rotate camera to look upward"
msgstr "  hotkey.camera.rotate.up – カメラを上向きに回転させる"

msgid "  hotkey.camera.up – Pan screen up"
msgstr "  hotkey.camera.up – パン スクリーンアップ"

msgid "  hotkey.cancel – Cancel"
msgstr "  hotkey.cancel – キャンセル"

msgid "  hotkey.cancel – Close all dialogs (chat, menu)"
msgstr "  hotkey.cancel – すべてのダイアログを閉じます（チャット、メニュー）"

msgid "  hotkey.civinfo – Toggle civilization info panel"
msgstr "  hotkey.civinfo – 文明一覧の切り替え"

msgid "  hotkey.confirm – Open chat or send message"
msgstr "  hotkey.confirm – チャットを開く、もしくはメッセージを送信します"

msgid "  hotkey.console.toggle – Toggle console"
msgstr "  hotkey.console.toggle – コンソールの切り替え"

msgid "  hotkey.exit – Immediately close the game, without asking for confirmation"
msgstr " hotkey.exit – 確認を求めず、即座にゲームを終了させます。"

msgid "  hotkey.fps.toggle – Toggle frame counter (FPS)"
msgstr "  hotkey.fps.toggle – フレーム表示を切り替えます (FPS)"

msgid "  hotkey.lobby – Show the multiplayer lobby in a dialog window"
msgstr "  hotkey.lobby – マルチプレイヤーロビーをダイアログウィンドウで表示します"

msgid "  hotkey.pause – Pause or resume the game"
msgstr "  hotkey.pause – ゲームを一時停止または再開します"

msgid "  hotkey.privatechat – Chat with the previously selected private chat partner"
msgstr "  hotkey.privatechat – 事前に選択したプライベートチャットの相手とチャットします"

msgid "  hotkey.profile.save – Save current profiler data to “logs/profile.txt”"
msgstr "  hotkey.profile.save – 現在のプロファイルデータを“logs/profile.txt”に保存します "

msgid "  hotkey.profile.toggle – Toggle real-time profiler (cycles through the displays of information)"
msgstr "  hotkey.profile.toggle – リアルタイムプロファイラの切り替え(情報表示の繰り返し)"

msgid "  hotkey.quickload – Quickload"
msgstr "  hotkey.quickload – クイックロード"

msgid "  hotkey.quicksave – Quicksave"
msgstr "  hotkey.quicksave – クイックセーブ"

msgid "  hotkey.screenshot – Take screenshot (in .png format, location is displayed in the top left of the GUI after the file has been saved, and can also be seen in the console/logs if you miss it there)"
msgstr "　hotkey.screenshot – スクリーンショットを撮ります。(.png 形式、場所はファイル保存後にGUIの左上に表示されます。)"

msgid "  hotkey.selection.add + Left Click or Left Drag over unit on map – Add unit to selection"
msgstr "  hotkey.selection.add + マップのユニットの上で左クリックまたは左ドラッグ – 選択範囲にユニットを追加"

msgid "  hotkey.selection.add – Modifier – add to selection (works with clicking and hotkeys, e.g. the idle hotkeys)"
msgstr "  hotkey.selection.add – Modifier – 選択範囲に追加 (クリックとホットキーで動作。アイドルホットキーなど)"

msgid "  hotkey.selection.group.add.1 – Add control group 1 (to 0) to the selected unit(s)/structure(s)"
msgstr "  hotkey.selection.group.add.1 – 選択したユニット/建物に制御グループ1（～0）を追加します。"

msgid "  hotkey.selection.group.save.1 – Create control group 1 (by default, respectively 2,3, ...) from the selected unit(s)/structure(s)"
msgstr "  hotkey.selection.group.save.1 – 選択したユニット/建物からコントロールグループ1（デフォルトではそれぞれ2,3,...）を作成します"

msgid "  hotkey.selection.group.select.1 – Select the unit(s)/structure(s) in control group 1"
msgstr "  hotkey.selection.group.select.1 – コントロールグループ1のユニット/建物を選択します"

msgid "  hotkey.selection.idlebuilder – Select idle builder"
msgstr "  hotkey.selection.idlebuilder –手の空いてる建築者を選択します"

msgid "  hotkey.selection.idleunit – Select idle unit"
msgstr "  hotkey.selection.idleunit – 手の空いているユニットを選択します"

msgid "  hotkey.selection.idlewarrior – Select idle fighter"
msgstr "  hotkey.selection.idlewarrior – 手の空いている兵士を選択します"

msgid "  hotkey.selection.idleworker – Select idle worker (including citizen-soldiers)"
msgstr "  hotkey.selection.idleworker – 手の空いている働く人を選択します (市民兵を含む)"

msgid "  hotkey.selection.remove + Left Click or Left Drag over unit on map – Remove unit from selection"
msgstr "  hotkey.selection.remove + マップのユニットの上で左クリックまたは左ドラッグ – 選択からユニットを削除"

msgid "  hotkey.selection.remove – Modifier – remove from selection (works with clicking and hotkeys, e.g. the idle hotkeys)"
msgstr "  hotkey.selection.remove – Modifier – 選択範囲から外す（クリックとホットキーで動作。例：アイドルホットキー）"

msgid "  hotkey.session.backtowork – The unit will go back to work"
msgstr "  hotkey.session.backtowork – ユニットを作業に復帰させます"

msgid "  hotkey.session.batchtrain + Left Click when training units – Add units in batches (the batch size is 5 by default and can be changed in the options)"
msgstr "  hotkey.session.batchtrain + ユニットを養成するとき左クリック – ユニットの一括追加（バッチサイズはデフォルトで5、オプションで変更可能）"

msgid "  hotkey.session.garrison + Right Click on structure – Garrison"
msgstr "  hotkey.session.garrison + 建物を右クリック – 駐留"

msgid "  hotkey.session.gui.barter.toggle – Toggle in-game barter and trade panel"
msgstr "  hotkey.session.gui.barter.toggle – ゲーム内の物々交換と貿易パネルを切り替えます"

msgid "  hotkey.session.gui.diplomacy.toggle – Toggle in-game diplomacy panel"
msgstr "  hotkey.session.gui.diplomacy.toggle – ゲーム中の外交パネルを切り替えます"

msgid "  hotkey.session.gui.menu.toggle – Toggle menu"
msgstr "  hotkey.session.gui.menu.toggle – メニューの切り替え"

msgid "  hotkey.session.gui.objectives.toggle – Toggle in-game objectives panel"
msgstr "  hotkey.session.gui.objectives.toggle – ゲーム内目標パネルの切り替え"

msgid "  hotkey.session.gui.tutorial.toggle – Toggle in-game tutorial panel"
msgstr "  hotkey.session.gui.tutorial.toggle – ゲーム内チュートリアルパネルの切り替え"

msgid "  hotkey.session.highlightguarded with unit(s) selected – Highlight the unit(s)/structure(s) guarded by the selection"
msgstr "  hotkey.session.highlightguarded with unit(s) selected – 選択したユニット/建物をハイライト表示します。"

msgid "  hotkey.session.highlightguarding with unit(s)/structure(s) selected – Highlight the unit(s) guarding the selection"
msgstr "  hotkey.session.highlightguarding with unit(s)/structure(s) selected – 選択部分をガードしているユニットをハイライト表示します。"

msgid "  hotkey.session.kill – Delete currently selected unit(s)/structure(s), ask for confirmation"
msgstr "  hotkey.session.kill – 現在選択されているユニット/建築物を削除し、確認を求めます"

msgid "  hotkey.session.orderone + Right Click – Order one unit from the current selection to move/build/gather/etc. and unselect it. Used to quickly dispatch units with specific tasks"
msgstr "  hotkey.session.orderone + 右クリック – 現在の選択範囲から1つのユニットに移動／建設／採集などを命令し、選択を解除します。特定のタスクを持つユニットを素早く派遣するために使用します。"

msgid "  hotkey.session.patrol + Right Click – Patrol"
msgstr "  hotkey.session.patrol + 右クリック – パトロール"

msgid "  hotkey.session.queue + Right Click – Queue the move/build/gather/etc. order"
msgstr "  hotkey.session.queue + 右クリック – 移動/建設/採集/などの順番でキューに入れます"

msgid "  hotkey.session.queueunit.1, hotkey.session.queueunit.2, hotkey.session.queueunit.3, hotkey.session.queueunit.4, hotkey.session.queueunit.5, hotkey.session.queueunit.6, hotkey.session.queueunit.7 – With training structure selected. Add the 1st, 2nd, … unit shown to the training queue for all the selected structures"
msgstr "  hotkey.session.queueunit.1, hotkey.session.queueunit.2, hotkey.session.queueunit.3, hotkey.session.queueunit.4, hotkey.session.queueunit.5, hotkey.session.queueunit.6, hotkey.session.queueunit.7 – 養成できる施設を選択した状態で、選択されたすべての建物に表示されている1番目、2番目...のユニットをトレーニングキューに追加します。"

msgid "  hotkey.session.repair + Right Click on structure – Repair"
msgstr "  hotkey.session.repair + 建物を右クリック – 修理"

msgid "  hotkey.session.savedgames.delete – Delete the selected saved game, ask for confirmation"
msgstr "  hotkey.session.savedgames.delete – 選択したセーブゲームを削除し、確認を求めます"

msgid "  hotkey.session.stop – Stop (halt) the currently selected units"
msgstr "  hotkey.session.stop – 選択しているユニットを停止させます"

msgid "  hotkey.session.unload – Unload the garrisoned units of the selected structure(s)"
msgstr "  hotkey.session.unload – 選択した建物の駐留部隊を外に出します"

msgid "  hotkey.structree – Toggle structure tree panel"
msgstr "  hotkey.structree – 建設早見表の切り替え"

msgid "  hotkey.summary – Toggle summary window"
msgstr "  hotkey.summary – 総括画面の切り替え"

msgid "  hotkey.tab.next – Switch to the next tab"
msgstr "  hotkey.tab.next – 次のタブに切り替えます"

msgid "  hotkey.tab.prev – Switch to the previous tab"
msgstr "  hotkey.tab.prev – 前のタブに切り替えます"

msgid "  hotkey.teamchat – Send team chat"
msgstr "  hotkey.teamchat – チームチャットの送信"

msgid "  hotkey.timeelapsedcounter.toggle – Toggle time elapsed counter"
msgstr "  hotkey.timeelapsedcounter.toggle – 経過時間カウンターの切り替え"

msgid "  hotkey.togglefullscreen – Toggle between fullscreen and windowed"
msgstr "  hotkey.togglefullscreen – フルスクリーンとウィンドウ表示を切り替えます"

msgid " 1. Follow all usage policies."
msgstr "1. すべての利用方針に従うこと。"

msgid " 1. Hardware Details, for example the screen size, CPU clock rate, memory capacity and the sound card manufacturer."
msgstr "1. ハードウェアの詳細。例えば、画面のサイズやCPU のクロック周波数やメモリの容量、サウンドカードのメーカーなど。"

msgid " 2. Appoint others to moderate the service."
msgstr "2. 当サービスを運営する他者を任命すること。"

msgid " 2. System Software Details, for example the operating system version, graphics driver version, OpenGL capabilities."
msgstr "2. システムソフトウェアの詳細。例えば、OSのバージョンやグラフィックドライバーのバージョン、OpenGLの機能など。"

msgid " 7. Not attempt to artificially adjust any user of the service's rating or any of the statistics which impact it. (Examples of this are, but are not limited to: cheating in ranked games, reverse engineering the service, and taking advantage of other users of the service.)"
msgstr "7. 人為的に当サービスの任意の利用者の得点あるいは得点に影響する任意の統計を改変しようと試みること。（この例として、得点記録ゲームでのチートや当サービスのリバースエンジニアリングで当サービスの他の利用者より優位に立つこと、ただしこの例に限定されません）"

msgid "#%i"
msgstr "#%i"

msgid "%(AIdifficulty)s %(AIbehavior)s %(AIname)s"
msgstr "%(AIdifficulty)s %(AIbehavior)s %(AIname)s"

msgid "%(_player_)s and I are now allies."
msgstr "%(_player_)sと我が国は現在同盟関係にあります。"

msgid "%(_player_)s and I are now enemies."
msgstr "%(_player_)sと我が国は現在敵対しています。"

msgid "%(_player_)s and I are now neutral."
msgstr "%(_player_)sと我が国は現在中立を保っています。"

msgid "%(_player_)s and their allies have captured all relics and will win in %(time)s."
msgstr "%(_player_)sと同盟国は、すべての聖遺物を確保した為%(time)sで勝利します"

msgid "%(_player_)s has captured all relics and will win in %(time)s."
msgstr "%(_player_)sは、すべての聖遺物を確保した為%(time)sで勝利します"

msgid "%(_player_)s owns a Wonder and %(_player_)s and their allies will win in %(time)s."
msgstr "%(_player_)sが象徴を所有した為%(_player_)sと同盟国は%(time)sで勝利します。"

msgid "%(_player_)s owns a Wonder and will win in %(time)s."
msgstr "%(_player_)sは象徴を所有した為、%(time)sで勝利します"

msgid "%(_player_)s owns a Wonder and you will win in %(time)s."
msgstr "%(_player_)sは象徴を所有した為、あなたは%(time)sで勝利します"

msgid "%(_player_)s, I have decided to revoke my offer for a neutrality pact."
msgstr "%(_player_)s、中立協定の申し出を撤回することにしました。"

msgid "%(_player_)s, I have rescinded my previous offer for an alliance between us."
msgstr "%(_player_)s、私たちの間で同盟を結ぶという前回の申し出を撤回しました。"

msgid "%(_player_)s, I must decline your request for a neutrality pact."
msgstr "%(_player_)sとの中立協定の申請を辞退しなければなりません。"

msgid "%(_player_)s, I will accept your neutrality request. May both our civilizations benefit."
msgstr "%(_player_)s、私はあなたの中立の提案を受け入れましょう。双方の文明に利益がもたらされますように。"

msgid "%(_player_)s, I will not accept your neutrality request unless you tribute me %(_amount_)s %(_resource_)s soon."
msgstr "%(_player_)s、私に%(_amount_)s%(_resource_)sを送って貰えない場合私はあなたの中立の要求は受け入れません。"

msgid "%(_player_)s, I would like to request a neutrality pact between our civilizations. If you become neutral with me, I will respond in kind."
msgstr "%(_player_)s、中立条約を提案します。あなたが私と中立になれば、それに応じましょう。"

msgid "%(_player_)s, as you have failed to respond to my request for peace between us, I have abrogated my offer."
msgstr "%(_player_)s、あなたは私の和平の要求に応えてくれなかったので、私は申し出を破棄します。"

msgid "%(_player_)s, consider us allies from now on."
msgstr "%(_player_)s、私達との同盟を今から考えてみてください。"

msgid "%(_player_)s, if you do not send me part of the %(_amount_)s %(_resource_)s tribute soon, I will break off our negotiations."
msgstr "%(_player_)s、あなたがすぐに%(_amount_)s%(_resource_)sの貢ぎ物を送ってくれないならば交渉を打ち切ります。"

msgid "%(_player_)s, if you send me %(_amount_)s %(_resource_)s, I will accept a neutrality pact."
msgstr "%(_player_)s、 私に%(_amount_)s%(_resource_)sを送ってくれれば、中立条約を受け入れます。"

msgid "%(_player_)s, it would be both to our benefit if we negotiated a neutrality pact. I will become neutral with you if you do the same."
msgstr "%(_player_)s、私は中立条約を結んだ方がお互いのためになると思います。中立にしてもらえれば、それに応えましょう。"

msgid "%(_player_)s, it would help both of our civilizations if we formed an alliance. If you become allies with me, I will respond in kind."
msgstr "%(_player_)s、同盟を結べば、お互いの文明の助けになるでしょう。あなたが私と同盟を結ぶならば、それに応えましょう。"

msgid "%(_player_)s, my offer for an alliance has expired."
msgstr "%(_player_)s、私の同盟の申し出は失効しました。"

msgid "%(_player_)s, my offer still stands. I will ally with you only if you send me a tribute of %(_amount_)s %(_resource_)s."
msgstr "%(_player_)s、私の申し出はまだ有効です。あなたが%(_amount_)s%(_resource_)sの貢ぎ物を送ってくれるならば、私はあなたと同盟を結ぼう。"

msgid "%(_player_)s, only a neutrality agreement is conceivable to me."
msgstr "%(_player_)s、私には中立協定しか考えられません。"

msgid "%(_player_)s, you must send me a tribute of %(_amount_)s %(_resource_)s before I accept an alliance with you."
msgstr "%(_player_)s、同盟を受け入れる前に、%(_amount_)s%(_resource_)sの貢ぎ物を私に送ってもらいたい。"

msgid "%(action)s to train %(number)s (%(fullBatch)s + %(remainderBatch)s)."
msgstr "%(action)sで %(number)s (%(fullBatch)s + %(remainderBatch)s) 体養成します。"

msgid "%(action)s to train %(number)s (%(fullBatch)s)."
msgstr "%(action)sで %(number)s (%(fullBatch)s) 体養成します。"

msgid "%(action)s to train %(number)s."
msgstr "%(action)sで%(number)s体養成します。"

msgid "%(amount)s %(name)s"
msgstr "%(amount)s %(name)s"

msgid "%(amount)s %(resourceType)s"
msgstr "%(amount)s %(resourceType)s"

msgid "%(amount)s / %(max)s"
msgstr "%(amount)s / %(max)s"

msgid "%(amount)s%%"
msgstr "%(amount)s%%"

msgid "%(attackLabel)s: %(effects)s, %(range)s, %(rate)s%(statusEffects)s%(splash)s"
msgstr "%(attackLabel)s: %(effects)s, %(range)s, %(rate)s%(statusEffects)s%(splash)s"

msgid "%(attackType)s"
msgstr "%(attackType)s"

msgid "%(auralabel)s %(aurainfo)s"
msgstr "%(auralabel)s %(aurainfo)s"

msgid "%(auraname)s:"
msgstr "%(auraname)s:"

msgid "%(buildings)s*%(batchSize)s"
msgstr "%(buildings)s*%(batchSize)s"

msgid "%(captureLabel)s %(current)s / %(max)s"
msgstr "%(captureLabel)s %(current)s / %(max)s"

msgid "%(capturePoints)s / %(maxCapturePoints)s"
msgstr "%(capturePoints)s / %(maxCapturePoints)s"

msgid "%(category)s build limit of %(limit)s reached"
msgstr "%(category)sは建造数量上限%(limit)sに達しました"

msgid "%(category)s limit of %(limit)s reached"
msgstr "%(category)s上限%(limit)sに達しました"

msgid "%(category)s training limit of %(limit)s reached"
msgstr "%(category)sは養成上限%(limit)sに達しました"

msgid "%(changer)s enlarges the limit with %(change)s."
