msgstr "  hotkey.session.rotate.cw — поворот здания на 15 градусов по часовой стрелке"

msgid "  hotkey.session.savedgames.delete – Delete the selected saved game, ask for confirmation"
msgstr " hotkey.session.savedgames.delete — удалить выделенную сохранённую игру, спросив разрешения"

