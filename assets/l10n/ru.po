msgstr " hotkey.silhouettes — переключить режим отображения силуэтов юнитов (выключение может дать небольшой прирост производительности)"

msgid "  hotkey.structree – Toggle structure tree panel"
msgstr " hotkey.structree — показать или скрыть панель древа строительства"

msgid "  hotkey.summary – Toggle summary window"
msgstr " hotkey.summary — показать или скрыть окно со сводной таблицей игры"

msgid "  hotkey.tab.next – Switch to the next tab"
msgstr " hotkey.tab.next — переключиться на следующую вкладку"

msgid "  hotkey.tab.prev – Switch to the previous tab"
msgstr " hotkey.tab.prev — переключиться на предыдущую вкладку"

msgid "  hotkey.teamchat – Send team chat"
msgstr " hotkey.teamchat – отправить в чат команды"

msgid "  hotkey.timeelapsedcounter.toggle – Toggle time elapsed counter"
msgstr " hotkey.timeelapsedcounter.toggle — показать или скрыть время, прошедшее с начала игры"

