.godot/
*.user
obj/
bin/
build/
# CC0 drop zone — large binaries ignored, keep canonical assets/ small
assets/imported/
# Godot imports are generated, not committed (keep repo small)
*.import
__pycache__/
*.pyc
assets/models/**/*_tex*.png
# GDExtension build artifacts — rebuilt via SCons, do not commit
native/bin/
native/.sconsign.dblite
native/src/**/*.os
native/src/**/*.o
# godot-cpp is a large upstream dependency — fetch via `git clone --branch 4.3 https://github.com/godotengine/godot-cpp.git native/godot-cpp`
native/godot-cpp/
# mono/.NET leftover after pure C++ migration
.mono/
data_*/
.mono/
# Large 0 A.D. animation binaries — regenerated via tools/extract_0ad_assets.py --all-animations (1220 PSA ~30MB)
assets/animations/*.psa
assets/animations/*.json
assets/skeletons/*.xml
# Keep manifest.json (small) but ignore generated GLBs beyond MVP (regenerate via --all)
assets/models/vegetation/barracks.glb
assets/models/vegetation/cavalry.glb
assets/models/vegetation/market.glb
assets/models/vegetation/pine.glb
assets/models/vegetation/temple.glb
assets/models/vegetation/farmstead.glb
assets/models/vegetation/storehouse.glb
assets/models/vegetation/wall*.glb
assets/models/vegetation/fortress.glb
assets/models/vegetation/ram.glb
assets/models/vegetation/deer.glb
assets/models/vegetation/palm.glb
assets/models/vegetation/stone_mine.glb
assets/models/vegetation/ruins.glb
assets/models/vegetation/spearman.glb
assets/models/vegetation/archer.glb
