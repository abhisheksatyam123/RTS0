.godot/
*.user
obj/
bin/
build/
# CC0 drop zone — large binaries ignored, keep canonical assets/ small
assets/imported/
# Godot imports are generated, not committed (keep repo small)
*.import
__pycache__/
*.pyc
assets/models/**/*_tex*.png
# GDExtension build artifacts — rebuilt via SCons, do not commit
native/bin/
native/.sconsign.dblite
native/src/**/*.os
native/src/**/*.o
# godot-cpp is a large upstream dependency — fetch via `git clone --branch 4.3 https://github.com/godotengine/godot-cpp.git native/godot-cpp`
native/godot-cpp/
# mono/.NET leftover after pure C++ migration
.mono/
data_*/
.mono/
# Large extra 0 A.D. PSA dumps from --all-animations (~30MB). Curated clips are stored:
# assets/animations/{biped,citizen,gather,cavalry}_*.psa
# Full dump: python3 tools/extract_0ad_assets.py --all-animations
