# Godot generated data and editor state. Imports are generated, not committed.
.godot/
*.import
*.user

# Build output (SCons writes these at the repository root)
/bin/
/build/
/obj/
/.cache/
*.o
*.os
.sconsign.dblite
compile_commands.json
.clangd

# godot-cpp is a large upstream dependency — fetch via
# `git clone --branch 4.3 https://github.com/godotengine/godot-cpp.git godot-cpp`
/godot-cpp/

# CC0 drop zone — large binaries ignored, keep canonical assets/ small
assets/imported/
# Godot unpacks a dae_to_glb.gd model's skin as <id>_0.png
assets/models/**/*_tex*.png
assets/models/**/*_[0-9].png

# Python tooling
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# OS, editor and merge debris
.DS_Store
._*
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~
*.tmp
*.bak
*.orig
*.rej

# Secrets
.env
.env.*
!.env.example

# Logs
logs/
*.log

# Local test captures and scratch — not committed (generated by scratch/*.gd tests)
/screen*.png
/scratch/
/scratchpad/*
!/scratchpad/todo.md

# mono/.NET leftover after pure C++ migration
/.mono/
/data_*/

# Large extra 0 A.D. PSA dumps from --all-animations (~30MB). Curated clips are stored:
# assets/animations/{biped,citizen,gather,cavalry}_*.psa
# Full dump: python3 tools/extract_0ad_assets.py --all-animations
