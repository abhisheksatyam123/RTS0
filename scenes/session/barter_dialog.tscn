[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scenes/session/barter_dialog.gd" id="1"]

[node name="BarterDialog" type="CanvasLayer"]
script = ExtResource("1")

[node name="CenterContainer" type="CenterContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Panel" type="Panel" parent="CenterContainer"]
custom_minimum_size = Vector2(460, 260)
layout_mode = 2

[node name="VBox" type="VBoxContainer" parent="CenterContainer/Panel"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 16.0
offset_top = 14.0
offset_right = -16.0
offset_bottom = -14.0
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="CenterContainer/Panel/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 17
text = "⚖️ Athenian Agora — Market & Barter Exchange"
horizontal_alignment = 1

[node name="Desc" type="Label" parent="CenterContainer/Panel/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 11
theme_override_colors/font_color = Color(0.8, 0.85, 0.9, 1)
text = "Exchange surplus commodities for gold or scarce materials at 25% transaction spread."
horizontal_alignment = 1

[node name="Grid" type="GridContainer" parent="CenterContainer/Panel/VBox"]
layout_mode = 2
columns = 3
theme_override_constants/h_separation = 12
theme_override_constants/v_separation = 8

[node name="BtnSellWood" type="Button" parent="CenterContainer/Panel/VBox/Grid"]
layout_mode = 2
text = "🌲 Sell 100 Wood (+75 Gold)"

[node name="BtnBuyWood" type="Button" parent="CenterContainer/Panel/VBox/Grid"]
layout_mode = 2
text = "🌲 Buy 100 Wood (-100 Gold)"

[node name="BtnSellFood" type="Button" parent="CenterContainer/Panel/VBox/Grid"]
layout_mode = 2
text = "🍞 Sell 100 Food (+75 Gold)"

[node name="BtnBuyFood" type="Button" parent="CenterContainer/Panel/VBox/Grid"]
layout_mode = 2
text = "🍞 Buy 100 Food (-100 Gold)"

[node name="BtnSellStone" type="Button" parent="CenterContainer/Panel/VBox/Grid"]
layout_mode = 2
text = "🪨 Sell 100 Stone (+75 Gold)"

[node name="BtnBuyStone" type="Button" parent="CenterContainer/Panel/VBox/Grid"]
layout_mode = 2
text = "🪨 Buy 100 Stone (-100 Gold)"

[node name="CloseBtn" type="Button" parent="CenterContainer/Panel/VBox"]
custom_minimum_size = Vector2(120, 32)
layout_mode = 2
size_flags_horizontal = 4
text = "Close"

[connection signal="pressed" from="CenterContainer/Panel/VBox/CloseBtn" to="." method="_on_close_pressed"]
